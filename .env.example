# Slack Credentials
# Get these from your Slack app configuration at https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-bot-token        # Bot User OAuth Token from OAuth & Permissions
SLACK_SIGNING_SECRET=your-signing-secret   # Signing Secret from Basic Information

# OpenAI Credentials
# Get this from your OpenAI account at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key

# Solana configuration
# An RPC url, and a secret key for the wallet that will be used to pay for the orders
# EVM Wallet for Base-Sepolia
SIGNER_WALLET_SECRET_KEY=0x-your-evm-private-key-from-metamask
RPC_PROVIDER_URL=https://sepolia.base.org
SMART_WALLET_ADDRESS=your-crossmint-smart-wallet-address
# Crossmint API Key
CROSSMINT_API_KEY=your-crossmint-api-key

# JSON string of office addresses
OFFICE_ADDRESSES=